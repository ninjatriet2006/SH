# Rust build artifacts
/target/
**/*.rs.bk

# GUI build artifacts (source code IS tracked)
GUI/**/node_modules/
GUI/**/dist/
GUI/**/target/
GUI/temp_app/
# AppImage extraction trees created by packaging/smoke commands.
# Existing tracked copies are not removed by this rule.
GUI/**/squashfs-root/

# Test / coverage output
GUI/**/coverage/
GUI/**/playwright-report/
GUI/**/test-results/

# Scratch & throwaway artifacts
*.log
/large*.bin
/test_check
/test_check.rs
/test_src.txt
/test_dst.txt
/test_src/
/test_dst/
GUI/**/replace*.py
GUI/**/testfile

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment and secrets
.env
*.env.local

# Release build artifacts
/release/

# DỮ LIỆU RIÊNG TƯ — KHÔNG BAO GIỜ commit (repo này công khai).
# `storage/` chứa data.json (thông tin khách hàng, số dư, giao dịch),
# settings.json và các bản sao lưu tự động. Bản `release/` đã bị chặn bởi
# `/release/` ở trên, nhưng khi chạy `cargo tauri dev` thì app ghi vào
# `GUI/<app>/storage/` — đường dẫn đó KHÔNG nằm trong `/release/`.
GUI/**/storage/
/storage/
**/data.json
**/settings.json

# Third-party repositories
Nemo/
rust-analyzer-src/

# Understand-Anything scratch (graph + config vẫn được track)
.ua/intermediate/
.ua/tmp/
.ua/.trash-*/
