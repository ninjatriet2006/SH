{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rclone_gui",
  "version": "0.1.0",
  "identifier": "com.rclone.gui",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Rclone GUI",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
