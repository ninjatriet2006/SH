{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Converter",
  "version": "0.1.0",
  "identifier": "com.sh.universal-converter",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universal Converter — GUI",
        "width": 900,
        "height": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/langs/**",
          "$RESOURCE/themes/**",
          "$RESOURCE/fonts/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "icon": ["icons/icon.png"],
    "createUpdaterArtifacts": false,
    "resources": {
      "../langs/": "langs/",
      "../themes/": "themes/",
      "../fonts/DejaVuSans.ttf": "fonts/DejaVuSans.ttf",
      "../fonts/LICENSE.txt": "fonts/LICENSE.txt",
      "../fonts/manifest.sha256": "fonts/manifest.sha256"
    }
  },
  "plugins": {}
}
